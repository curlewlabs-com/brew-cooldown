#!/bin/sh
set -eu

project_directory=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
# Homebrew forwards its help flag to external commands. The nested Ruby
# launcher must reach our argument parser instead of showing its own help.
unset HOMEBREW_HELP
# Homebrew filters ordinary environment variables before entering Ruby.
exec env HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_DEVELOPER=1 HOMEBREW_NO_INSTALL_CLEANUP=1 \
  HOMEBREW_COOLDOWN_STATE_HOME="${XDG_STATE_HOME:-${HOMEBREW_COOLDOWN_STATE_HOME:-$HOME/.local/state}}" \
  HOMEBREW_COOLDOWN_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOMEBREW_COOLDOWN_CONFIG_HOME:-$HOME/.config}}" \
  "${HOMEBREW_BREW_FILE:-brew}" ruby -- "$project_directory/lib/brew_cooldown/cli.rb" "$@"
