#!/bin/sh
set -eu

# Propose the newest Homebrew release for qualification. On a stable
# installation `brew update` moves Homebrew to that tag, and `upgrade` refuses
# there until VALIDATED_HOMEBREW_COMMIT names it, so the pull request should
# exist before anyone's scheduled run meets the refusal. The Homebrew release
# workflow runs this with its job token in GH_TOKEN and the proposal token in
# PROPOSAL_TOKEN; see CONTRIBUTING.md.

project_directory=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_directory"
constant=lib/brew_cooldown/validated_homebrew.rb
upstream=https://github.com/Homebrew/brew

# The same choice Homebrew's update.sh makes: the highest version-sorted tag
# shaped like a release. sed -n 1p reads to the end, so nothing upstream of
# it in the pipeline dies of SIGPIPE.
tag=$(git ls-remote --tags --refs --sort=-version:refname "$upstream" |
  sed -n 's|^[0-9a-f]*[[:space:]]refs/tags/\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)$|\1|p' |
  sed -n 1p)
if [ -z "$tag" ]; then
  echo "No Homebrew release tag found at $upstream" >&2
  exit 1
fi
commit=$(gh api "repos/Homebrew/brew/commits/$tag" --jq .sha)
current=$(ruby -r "./$constant" -e 'print BrewCooldown::VALIDATED_HOMEBREW_COMMIT')
if [ "$commit" = "$current" ]; then
  echo "Homebrew $tag ($commit) is already the qualified commit"
  exit 0
fi

# A qualified commit ahead of the newest release (a development commit, say)
# must not be walked back to it.
relation=$(gh api "repos/Homebrew/brew/compare/$current...$commit" --jq .status)
if [ "$relation" != ahead ]; then
  echo "Homebrew $tag ($commit) is $relation of the qualified commit $current; nothing to propose"
  exit 0
fi

# One proposal per release. An existing branch means this release was already
# proposed; if its qualification failed, the fix belongs on that branch.
branch=homebrew/$tag
if git ls-remote --exit-code --heads origin "$branch" >/dev/null; then
  echo "Homebrew $tag was already proposed on $branch"
  exit 0
fi

# Checked before anything is pushed: a branch left without its pull request
# would read as already proposed to every later run.
if [ -z "${PROPOSAL_TOKEN:-}" ]; then
  echo "PROPOSAL_TOKEN is not set, so Homebrew $tag cannot be proposed; see CONTRIBUTING.md" >&2
  exit 1
fi
repository=$(gh repo view --json nameWithOwner --jq .nameWithOwner)

echo "Proposing Homebrew $tag ($commit), replacing $current"
git switch --quiet --create "$branch"
sed "s/$current/$commit/" "$constant" >"$constant.new"
mv "$constant.new" "$constant"
git -c user.name='github-actions[bot]' \
  -c user.email='41898282+github-actions[bot]@users.noreply.github.com' \
  commit --quiet --message "Qualify Homebrew $tag" -- "$constant"
git push --quiet origin "$branch"

body="\
Homebrew tagged [$tag](https://github.com/Homebrew/brew/releases/tag/$tag) at \`$commit\`. \`brew update\` moves a stable installation there, and \`upgrade\` refuses on it until \`VALIDATED_HOMEBREW_COMMIT\` names it.

This moves the constant. The Homebrew release workflow merges it once the Qualify workflow's \`qualified\` check passes on its head: that run is the evidence that the installer adapter still holds on this commit. Marking this a draft, or pushing anything else to the branch, leaves the merge to a person. If a track fails, the fix belongs on this branch.

Homebrew changes since the qualified commit: https://github.com/Homebrew/brew/compare/$current...$commit"
# The proposal token opens it so that its CI and Qualify runs start; see the
# Homebrew release workflow. A token that has expired or lost its access fails
# here, after the push, so the branch goes too and the next run retries.
if ! url=$(GH_TOKEN=$PROPOSAL_TOKEN gh api --method POST "repos/$repository/pulls" \
  -f base=main -f head="$branch" -f title="Qualify Homebrew $tag" -f body="$body" --jq .html_url); then
  git push --quiet --delete origin "$branch"
  echo "Could not open a pull request for $branch with PROPOSAL_TOKEN; deleted the branch so the next run retries" >&2
  exit 1
fi
echo "Opened $url"

# A newer release supersedes an older open proposal: `brew update` skips past
# the older tag, so qualifying it would fix nothing.
gh pr list --state open --json number,headRefName --jq '.[] | "\(.number) \(.headRefName)"' |
  while read -r number head; do
    case $head in
    "$branch") ;;
    homebrew/*) gh pr close "$number" --delete-branch --comment "Superseded by $url." ;;
    esac
  done
